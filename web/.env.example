# Set at build and runtime for the public saved-demo deployment.
CONSUL_JUDGE_DEMO=true
# Optional canonical public URL. No secret belongs in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development uses the local runner. Set sandbox in Vercel Preview to
# route Council requests through the hosted persistent Vercel Sandbox.
COUNCIL_EXECUTION_MODE=local
# Local live runs also require ENABLE_LOCAL_AGENT_PREVIEW=true.
# Vercel Production always uses the hosted worker.
ENABLE_LOCAL_AGENT_PREVIEW=false

# Hosted live Council. Keep these values server-only.
COUNCIL_SANDBOX_SNAPSHOT_ID=
COUNCIL_WORKER_TOKEN=
COUNCIL_SESSION_SECRET=
# Optional only when provisioning a sandbox from a local shell. Hosted Vercel
# deployments use OIDC and do not need this token.
# COUNCIL_SANDBOX_VERCEL_TOKEN=
# If you set that token, also set both project identifiers.
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Factory credentials and models used for live local or hosted Council runs.
FACTORY_API_KEY=
DROID_EXECUTABLE=
# Optional explicit shared fallback for any seat setting omitted below.
COUNCIL_MODEL_ID=
COUNCIL_REASONING_EFFORT=
# Confirm availability and supported effort with scripts/council-models.mjs.
COUNCIL_FINANCE_MODEL_ID=gpt-6.1-sol
COUNCIL_FINANCE_REASONING_EFFORT=medium
COUNCIL_OPERATIONS_MODEL_ID=gemini-3.8-flash
COUNCIL_OPERATIONS_REASONING_EFFORT=medium
COUNCIL_SKEPTIC_MODEL_ID=grok-4.7
COUNCIL_SKEPTIC_REASONING_EFFORT=medium
COUNCIL_CHAIR_MODEL_ID=claude-opus-5-5
COUNCIL_CHAIR_REASONING_EFFORT=medium
# Optional hosted admission limits. Defaults are 40 new rounds per UTC day
# and two active jobs globally. These count jobs, not provider spend.
# COUNCIL_DAILY_ROUND_LIMIT=40
# COUNCIL_CONCURRENT_LIMIT=2

# Server-only archive publisher token. Never expose it in browser variables.
SPACETIMEDB_URL=
SPACETIMEDB_DATABASE=
SPACETIMEDB_TOKEN=

# Optional account backend. Judge mode does not enable signup or private accounts.
# Configure the Figma Content API project and its credentials before disabling judge mode.
PAYLOAD_SECRET=
FIGMA_EID=
FIGMA_CONTENT_API_URL=
FIGMA_CONTENT_API_CONTENT_SYSTEM_ID=
FIGMA_CONTENT_API_ACCESS_KEY=
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
