# Set at build and runtime for the public saved-demo deployment.
CONSUL_JUDGE_DEMO=true
# Optional canonical public URL. No secret belongs in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local live council only. Public saved demos do not invoke these models.
FACTORY_API_KEY=
DROID_EXECUTABLE=
# Optional explicit shared fallback for any seat setting omitted below.
COUNCIL_MODEL_ID=
COUNCIL_REASONING_EFFORT=
# Confirm availability and supported effort with scripts/council-models.mjs.
COUNCIL_FINANCE_MODEL_ID=gpt-6.1-sol
COUNCIL_FINANCE_REASONING_EFFORT=medium
COUNCIL_OPERATIONS_MODEL_ID=gemini-3.8-flash
COUNCIL_OPERATIONS_REASONING_EFFORT=medium
COUNCIL_SKEPTIC_MODEL_ID=grok-4.7
COUNCIL_SKEPTIC_REASONING_EFFORT=medium
COUNCIL_CHAIR_MODEL_ID=claude-opus-5-5
COUNCIL_CHAIR_REASONING_EFFORT=medium

# Server-only archive publisher token. Never expose it in browser variables.
SPACETIMEDB_URL=
SPACETIMEDB_DATABASE=
SPACETIMEDB_TOKEN=

# Optional account backend. Judge mode does not enable signup or private accounts.
# Configure the Figma Content API project and its credentials before disabling judge mode.
PAYLOAD_SECRET=
FIGMA_EID=
FIGMA_CONTENT_API_URL=
FIGMA_CONTENT_API_CONTENT_SYSTEM_ID=
FIGMA_CONTENT_API_ACCESS_KEY=
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
