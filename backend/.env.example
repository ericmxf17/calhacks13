# Copy this file to backend/.env and fill in each agent's appId and API key.
# Create each key on that agent's detail page in agent.creao.ai. Keys start with capi_.
# backend/.env is in .gitignore. Never commit real keys.

CREAO_BILL_ANALYST_APP_ID=
CREAO_BILL_ANALYST_KEY=

CREAO_RESEARCHER_APP_ID=
CREAO_RESEARCHER_KEY=

CREAO_IMPACT_PLANNER_APP_ID=
CREAO_IMPACT_PLANNER_KEY=

CREAO_BRIEF_WRITER_APP_ID=
CREAO_BRIEF_WRITER_KEY=
